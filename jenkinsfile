pipeline {
agent any

```
tools {
    maven 'Maven3'
}

stages {

    stage('Checkout') {
        steps {
            git 'https://github.com/tu-repo.git'
        }
    }

    stage('Build') {
        steps {
            sh 'mvn clean package -DskipTests'
        }
    }

    stage('Test') {
        steps {
            sh 'mvn test'
        }
    }

    stage('Docker Build') {
        steps {
            sh 'docker build -t ivr-backend .'
        }
    }

    stage('Docker Compose Up') {
        steps {
            sh 'docker compose up -d'
        }
    }
}
```

}
